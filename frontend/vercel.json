{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-YOUR-RENDER-SERVICE.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://REPLACE-WITH-YOUR-RENDER-SERVICE.onrender.com/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://REPLACE-WITH-YOUR-RENDER-SERVICE.onrender.com/login/oauth2/:path*" },
    { "source": "/((?!api/|oauth2/|login/oauth2/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
