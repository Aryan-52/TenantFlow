# Copy this file to .env in the same directory as docker-compose.yml to configure
# optional integrations for the bundled local stack. Everything here is optional;
# the application works fully without any of it (Google OAuth just stays disabled).

# Google OAuth ("Continue with Google"). Create credentials at
# https://console.cloud.google.com/apis/credentials, with an authorized redirect URI
# of http://localhost:3000/login/oauth2/code/google for this bundled stack.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
