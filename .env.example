# Copy this file to .env in the same directory as docker-compose.yml. The file is git-ignored;
# never commit it. It is read by Docker Compose AND by the backend run from source
# (scripts/dev-backend.ps1, profile "local"). Write values without quotes.
# For the backend run from source TENANTFLOW_JWT_SECRET is required; everything else is
# optional (Google OAuth just stays disabled).

# Google OAuth ("Continue with Google"). Create credentials at
# https://console.cloud.google.com/apis/credentials, with these authorized redirect URIs:
#   http://localhost:8095/login/oauth2/code/google   (backend run from source, port 8095)
#   http://localhost:3000/login/oauth2/code/google   (Docker Compose stack)
# The client secret stays on the server: it is never sent to or built into the frontend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Local MinIO (attachments for the compose stack). Local-only defaults are used when unset.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# PostgreSQL credentials. Defaults (tenantflow/tenantflow) match existing local data
# volumes; changing them only takes effect when the postgres-data volume is first created.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT signing key (at least 32 bytes). Generate one with:  openssl rand -base64 48
# Required for the backend run from source (it stops with a clear message without it).
# The compose file falls back to a local-only placeholder when this is empty; every
# shared or production environment must set its own value.
TENANTFLOW_JWT_SECRET=

# Grafana (only with: docker compose --profile observability up -d).
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Running the backend from source (scripts/dev-backend.ps1, profile "local"):
# Swagger UI is on at http://localhost:8095/swagger-ui.html (TENANTFLOW_API_DOCS_ENABLED=false turns it off).
# It is always off under the prod profile, which the compose backend uses.
# Attachments are kept on disk at ~/.tenantflow/storage by default (TENANTFLOW_STORAGE_TYPE=filesystem);
# set TENANTFLOW_STORAGE_DIR to use another folder, or TENANTFLOW_STORAGE_TYPE=s3 to use MinIO/S3.
# Due-date reminders (in-app only) run every 15 minutes; TENANTFLOW_REMINDERS_ENABLED=false turns them off.
